# Groq API (free at console.groq.com) — same key used in the YouTube project works fine
GROQ_API_KEY=

# Telegram — reuse the SAME values from the YouTube_Auto_Publisher project's .env
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_SOURCE_CHAT=me

# Instagram (developers.facebook.com, free) — run setup/get_instagram_token.py once to get these
IG_ACCESS_TOKEN=
IG_USER_ID=

# GitHub (used only to temporarily host the video at a public URL for Instagram
# to fetch it — GitHub Actions provides GITHUB_TOKEN automatically; for local
# testing, create a Personal Access Token with "repo" scope)
GITHUB_TOKEN=
GITHUB_REPOSITORY= # e.g. tadjjn-cell/instagram-auto-publisher-2
